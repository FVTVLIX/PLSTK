# Keep the historical local documentation private.
# New public documents and screenshots must be explicitly reviewed here.
/docs/*
!/docs/BUILDING.md
!/docs/DEVELOPMENT.md
!/docs/DIRECTOR.md
!/docs/BRAND_DIRECTION.md
!/docs/UPDATE_DESCRIPTION.md
!/docs/images/
